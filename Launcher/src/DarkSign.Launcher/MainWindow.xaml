<Window x:Class="DarkSign.Launcher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="The Dark Sign" Height="520" Width="920"
        Background="#16141A" Foreground="#E6E0D4" FontFamily="Segoe UI" FontSize="13"
        Closing="OnClosing">
  <Window.Resources>
    <Style TargetType="Button">
      <Setter Property="Padding" Value="12,4" />
      <Setter Property="Margin" Value="4,0,0,0" />
    </Style>
    <Style TargetType="TextBlock">
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
  </Window.Resources>
  <DockPanel Margin="16">
    <TextBlock DockPanel.Dock="Top" Text="THE DARK SIGN" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,12" />

    <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="110" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBlock Text="Project folder" />
      <TextBox x:Name="RootBox" Grid.Column="1" IsReadOnly="True" />
      <StackPanel Grid.Column="2" Orientation="Horizontal">
        <Button Content="Change…" Click="OnChangeRoot" />
        <Button Content="Scan for games" Click="OnScan" />
      </StackPanel>
    </Grid>

    <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="110" />
        <ColumnDefinition Width="220" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <TextBlock Text="Profile" />
      <ComboBox x:Name="ProfileBox" Grid.Column="1" SelectionChanged="OnProfileChanged" />
      <StackPanel Grid.Column="2" Orientation="Horizontal">
        <Button Content="New…" Click="OnNewProfile" />
        <Button Content="Delete" Click="OnDeleteProfile" />
        <Button Content="Open saves folder" Click="OnOpenSaves" />
      </StackPanel>
    </Grid>

    <TextBlock x:Name="StatusText" DockPanel.Dock="Bottom" Margin="0,8,0,0" Opacity="0.8" TextWrapping="Wrap" />

    <DataGrid x:Name="GameGrid" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
              HeadersVisibility="Column" RowHeight="34" GridLinesVisibility="Horizontal"
              Background="#1F1C24" RowBackground="#1F1C24" Foreground="#E6E0D4" BorderBrush="#3A3542">
      <DataGrid.ColumnHeaderStyle>
        <Style TargetType="DataGridColumnHeader">
          <Setter Property="Background" Value="#2A2630" />
          <Setter Property="Foreground" Value="#E6E0D4" />
          <Setter Property="Padding" Value="6,4" />
        </Style>
      </DataGrid.ColumnHeaderStyle>
      <DataGrid.Columns>
        <DataGridTextColumn Header="Game" Binding="{Binding DisplayName}" IsReadOnly="True" Width="160" />
        <DataGridTextColumn Header="Exe" Binding="{Binding ExePath}" IsReadOnly="True" Width="*" />
        <DataGridTextColumn Header="Launch arguments" Binding="{Binding Arguments, UpdateSourceTrigger=PropertyChanged}" Width="170" />
        <DataGridTextColumn Header="Status" Binding="{Binding Status}" IsReadOnly="True" Width="120" />
        <DataGridTemplateColumn Width="150">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <StackPanel Orientation="Horizontal">
                <Button Content="Browse…" Click="OnBrowseExe" />
                <Button Content="Launch" Click="OnLaunch" FontWeight="SemiBold" />
              </StackPanel>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
      </DataGrid.Columns>
    </DataGrid>
  </DockPanel>
</Window>
