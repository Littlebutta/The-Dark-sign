<Window x:Class="DarkSign.Launcher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:DarkSign.Launcher"
        Title="The Dark Sign" Height="760" Width="1020" MinHeight="600" MinWidth="880"
        Style="{StaticResource MenuWindow}" Closing="OnClosing">
  <!-- Laid out like a Dark Souls III options screen: emblem and title over a fading rule, small dim section titles,
       labels right-aligned beside their values, ember glow on the selected row. Styles are in Theme.xaml. -->
  <DockPanel Margin="22,16,22,14">
    <!-- Header -->
    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,14">
      <DockPanel>
        <Border DockPanel.Dock="Left" Width="40" Height="40" BorderBrush="#8C7448" BorderThickness="1" Background="#E0080706" Padding="2">
          <Border BorderBrush="#40D8B070" BorderThickness="1">
            <Image Source="pack://application:,,,/Assets/darksign.png" Stretch="UniformToFill" Margin="-2" />
          </Border>
        </Border>
        <TextBlock x:Name="VersionText" DockPanel.Dock="Right" Foreground="{StaticResource DimTextBrush}" FontSize="13" VerticalAlignment="Bottom" />
        <TextBlock Text="The Dark Sign" FontFamily="{StaticResource TitleFont}" FontSize="26" Foreground="{StaticResource TitleBrush}" Margin="12,0,0,0" />
      </DockPanel>
      <Border Style="{StaticResource Rule}" Margin="0,8,0,0" />
    </StackPanel>

    <!-- Data folder and profile -->
    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
      <TextBlock Text="Data and profile" Style="{StaticResource SectionTitle}" />
      <Border Style="{StaticResource Rule}" Background="{StaticResource FaintRuleBrush}" Margin="0,0,0,8" />
      <Grid Margin="0,0,0,6">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="120" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock Text="Data folder" HorizontalAlignment="Right" Margin="0,0,14,0"
                   ToolTip="Where the mod, its tools and your Dark Sign saves are kept (in a TheDarkSign folder). Your game installs are never changed." />
        <TextBox x:Name="RootBox" Grid.Column="1" IsReadOnly="True" />
        <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="6,0,0,0">
          <Button Content="Change…" Click="OnChangeRoot" />
          <Button Content="Find my games" Click="OnScan" ToolTip="Looks in the data folder and in every Steam library on this PC." />
        </StackPanel>
      </Grid>
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="120" />
          <ColumnDefinition Width="240" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <TextBlock Text="Profile" HorizontalAlignment="Right" Margin="0,0,14,0" />
        <ComboBox x:Name="ProfileBox" Grid.Column="1" SelectionChanged="OnProfileChanged" />
        <WrapPanel Grid.Column="2" Margin="6,0,0,0">
          <Button Content="New…" Click="OnNewProfile" />
          <Button Content="Delete" Click="OnDeleteProfile" />
          <Button Content="Open saves folder" Click="OnOpenSaves" />
          <Button Content="Randomizer…" Click="OnRandomizer" />
        </WrapPanel>
      </Grid>
    </StackPanel>

    <!-- The main event: Elden Ring with the content ported from Dark Souls III. -->
    <Border DockPanel.Dock="Top" Background="#B40C0B0A" BorderBrush="{StaticResource FrameBrush}" BorderThickness="1" Padding="18,14" Margin="0,0,0,12">
      <DockPanel>
        <Button x:Name="PlayButton" DockPanel.Dock="Right" Style="{StaticResource PlayButton}" Content="PLAY"
                Width="170" Height="64" VerticalAlignment="Center" Margin="18,0,0,0" Click="OnPlayEldenRing" />
        <StackPanel>
          <TextBlock Text="Elden Ring  ·  The Dark Sign" FontFamily="{StaticResource TitleFont}" FontSize="19" Foreground="{StaticResource AccentBrush}" />
          <TextBlock Text="Elden Ring with Dark Souls III content. Offline, with this profile's own saves."
                     Foreground="{StaticResource DimTextBrush}" Margin="0,2,0,6" />
          <Border Style="{StaticResource Rule}" Background="{StaticResource FaintRuleBrush}" Margin="0,0,0,8" />
          <TextBlock x:Name="ContentText" Margin="0,0,0,10" TextWrapping="Wrap" />
          <WrapPanel>
            <CheckBox x:Name="TestMenuBox" Content="F1 test menu (give items and runes)" Margin="0,4,18,4"
                      Checked="OnTestMenuChanged" Unchecked="OnTestMenuChanged" />
            <CheckBox x:Name="SeamlessBox" Content="Seamless Co-op" Margin="0,4,18,4"
                      Checked="OnSeamlessChanged" Unchecked="OnSeamlessChanged"
                      ToolTip="Loads Seamless Co-op from your own download (pick its ersc.dll). Everyone in the session needs the same mod code shown above." />
          </WrapPanel>
          <WrapPanel Margin="-4,6,0,0">
            <Button x:Name="RebuildButton" Content="Rebuild content" Margin="4,2,0,2" Click="OnRebuildContent" />
            <Button Content="Fallbacks…" Margin="4,2,0,2" Click="OnFallbacks"
                    ToolTip="If a feature doesn't work in game, switch it to another method (B, C, …) here. Changing a build method rebuilds the content on the next PLAY." />
            <Button Content="Pre-flight check…" Margin="4,2,0,2" Click="OnPreflight"
                    ToolTip="Checks the game paths, me3 profile, sound banks and event flags before you test, and saves a zip of every log and report after a test." />
            <Button Content="Open mod folder" Margin="4,2,0,2" Click="OnOpenModFolder" />
            <Button x:Name="UninstallButton" Content="Uninstall…" Margin="4,2,0,2" Click="OnUninstall"
                    ToolTip="Removes the mod and everything the launcher downloaded or built. Your games are not changed; you choose whether to keep your saves." />
          </WrapPanel>
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- Everything the launcher does, porter output included, also written to TheDarkSignLauncher.log next to the exe. -->
    <Expander x:Name="LogExpander" DockPanel.Dock="Bottom" Margin="0,8,0,0"
              Header="Launcher activity (everything the launcher is doing)">
      <DockPanel Margin="0,4,0,0">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,4">
          <CheckBox x:Name="LogFollowBox" Content="Follow new lines" IsChecked="True" />
          <Button Content="Copy" Margin="12,0,0,0" Click="OnCopyLog" />
          <Button Content="Open log file" Click="OnOpenLogFile" />
          <Button Content="Clear" Click="OnClearLog" />
        </StackPanel>
        <TextBox x:Name="LogBox" Height="190" IsReadOnly="True" FontFamily="Consolas" FontSize="12"
                 Background="#0F0E12" Foreground="#CFC8BA" BorderBrush="#3A3542" TextWrapping="NoWrap"
                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" />
      </DockPanel>
    </Expander>
    <TextBlock x:Name="StatusText" DockPanel.Dock="Bottom" Margin="2,8,0,0" Foreground="{StaticResource DimTextBrush}" FontStyle="Italic" TextWrapping="Wrap" />

    <!-- Your games -->
    <StackPanel DockPanel.Dock="Top">
      <TextBlock Text="Your games" Style="{StaticResource SectionTitle}" />
      <TextBlock x:Name="GamesHint" Foreground="{StaticResource DimTextBrush}" FontSize="13" Margin="2,0,0,2" TextWrapping="Wrap"
                 Text="Point each one at your own install with Browse… (a Steam copy is fine; it is only read). Both are needed to build the mod." />
    </StackPanel>

    <Grid>
    <DataGrid x:Name="GameGrid" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
              Margin="0,4,0,0">
      <DataGrid.Columns>
        <DataGridTextColumn Header="Game" Binding="{Binding DisplayName}" IsReadOnly="True" Width="140" />
        <DataGridTextColumn Header="Exe" Binding="{Binding ExePath}" IsReadOnly="True" Width="*" />
        <DataGridTextColumn Header="Launch arguments" Binding="{Binding Arguments, UpdateSourceTrigger=PropertyChanged}" Width="140" />
        <DataGridTextColumn Header="Status" Binding="{Binding Status}" IsReadOnly="True" Width="140" />
        <DataGridTemplateColumn Width="180">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <StackPanel Orientation="Horizontal">
                <Button Content="Browse…" Click="OnBrowseExe" />
                <Button Content="Launch" Click="OnLaunch" IsEnabled="{Binding CanLaunch}" />
              </StackPanel>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
      </DataGrid.Columns>
    </DataGrid>

    <!-- Shown while the content builds: the Darksign ignites as the build goes, with a bar across the panel. -->
    <Border x:Name="BuildPanel" Visibility="Collapsed" Background="#C80A0908" BorderBrush="{StaticResource FrameBrush}" BorderThickness="1" Padding="18">
      <DockPanel>
        <Grid DockPanel.Dock="Bottom" Margin="0,12,0,0" Height="14">
          <Border x:Name="BarTrack" Background="#A00C0B0A" CornerRadius="7" BorderBrush="{StaticResource FrameBrush}" BorderThickness="1" />
          <Border x:Name="BarFill" HorizontalAlignment="Left" Width="0" CornerRadius="7">
            <Border.Background>
              <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                <GradientStop Color="#5A1A04" Offset="0" />
                <GradientStop Color="#C2410C" Offset="0.6" />
                <GradientStop Color="#FDBA54" Offset="1" />
              </LinearGradientBrush>
            </Border.Background>
            <Border.Effect>
              <DropShadowEffect Color="#FF7A1A" BlurRadius="14" ShadowDepth="0" Opacity="0.9" />
            </Border.Effect>
          </Border>
        </Grid>
        <local:DarksignProgress x:Name="Darksign" DockPanel.Dock="Left" Width="230" Height="230" Margin="0,0,20,0" />
        <StackPanel VerticalAlignment="Center">
          <TextBlock x:Name="BuildTitle" Text="Kindling the Dark Sign…" FontSize="24" Foreground="{StaticResource AccentBrush}"
                     FontFamily="{StaticResource TitleFont}" />
          <TextBlock Text="Building the mod from your own game files." Foreground="{StaticResource DimTextBrush}" Margin="0,2,0,6" />
          <Border Style="{StaticResource Rule}" Margin="0,0,0,10" />
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="130" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
            </Grid.RowDefinitions>
            <TextBlock Text="Time elapsed" Opacity="0.7" />
            <TextBlock x:Name="ElapsedText" Grid.Column="1" Text="0:00" FontSize="16" FontWeight="SemiBold" />
            <TextBlock Grid.Row="1" Text="Time remaining" Opacity="0.7" Margin="0,4,0,0" />
            <TextBlock x:Name="RemainingText" Grid.Row="1" Grid.Column="1" Text="estimating…" FontSize="16" FontWeight="SemiBold" Margin="0,4,0,0" />
            <TextBlock Grid.Row="2" Text="Weapons" Opacity="0.7" Margin="0,12,0,0" />
            <TextBlock x:Name="WeaponsLine" Grid.Row="2" Grid.Column="1" Opacity="0.85" Margin="0,12,0,0" TextTrimming="CharacterEllipsis" />
            <TextBlock Grid.Row="3" Text="Maps" Opacity="0.7" Margin="0,4,0,0" />
            <TextBlock x:Name="MapsLine" Grid.Row="3" Grid.Column="1" Opacity="0.85" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
          </Grid>
          <TextBlock Text="Every line the build prints is in Launcher activity below." Opacity="0.55" Margin="0,14,0,0" />
        </StackPanel>
      </DockPanel>
    </Border>
    </Grid>
  </DockPanel>
</Window>
