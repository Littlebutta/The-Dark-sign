<Window x:Class="DarkSign.Launcher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:DarkSign.Launcher"
        Title="The Dark Sign" Height="720" Width="960" MinHeight="560" MinWidth="820"
        Background="#16141A" Foreground="#E6E0D4" FontFamily="Segoe UI" FontSize="13"
        Closing="OnClosing">
  <Window.Resources>
    <Style TargetType="Button">
      <Setter Property="Padding" Value="12,4" />
      <Setter Property="Margin" Value="4,0,0,0" />
    </Style>
    <Style TargetType="TextBlock">
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
  </Window.Resources>
  <DockPanel Margin="16">
    <TextBlock DockPanel.Dock="Top" Text="THE DARK SIGN" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,12" />

    <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="110" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBlock Text="Data folder" ToolTip="Where the mod, its tools and your Dark Sign saves are kept (in a TheDarkSign folder). Your game installs are never changed." />
      <TextBox x:Name="RootBox" Grid.Column="1" IsReadOnly="True" />
      <StackPanel Grid.Column="2" Orientation="Horizontal">
        <Button Content="Change…" Click="OnChangeRoot" />
        <Button Content="Find my games" Click="OnScan" ToolTip="Looks in the data folder and in every Steam library on this PC." />
      </StackPanel>
    </Grid>

    <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="110" />
        <ColumnDefinition Width="220" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <TextBlock Text="Profile" />
      <ComboBox x:Name="ProfileBox" Grid.Column="1" SelectionChanged="OnProfileChanged" />
      <StackPanel Grid.Column="2" Orientation="Horizontal">
        <Button Content="New…" Click="OnNewProfile" />
        <Button Content="Delete" Click="OnDeleteProfile" />
        <Button Content="Open saves folder" Click="OnOpenSaves" />
        <Button Content="Randomizer…" Click="OnRandomizer" />
      </StackPanel>
    </Grid>

    <!-- The main event: Elden Ring with the content ported from the other games. -->
    <Border DockPanel.Dock="Top" Background="#221E28" BorderBrush="#6B5A3A" BorderThickness="1" Padding="16" Margin="0,0,0,12">
      <DockPanel>
        <Button x:Name="PlayButton" DockPanel.Dock="Right" Content="PLAY" FontSize="20" FontWeight="SemiBold"
                Width="150" Height="56" VerticalAlignment="Center" Click="OnPlayEldenRing" />
        <StackPanel>
          <TextBlock Text="ELDEN RING  ·  THE DARK SIGN" FontSize="18" FontWeight="SemiBold" />
          <TextBlock Text="Elden Ring with Dark Souls III content. Offline, with this profile's own saves." Opacity="0.75" Margin="0,2,0,8" />
          <TextBlock x:Name="ContentText" Opacity="0.9" Margin="0,0,0,8" TextWrapping="Wrap" />
          <StackPanel Orientation="Horizontal">
            <CheckBox x:Name="TestMenuBox" Content="F1 test menu (give items and runes)" Foreground="#E6E0D4"
                      VerticalAlignment="Center" Checked="OnTestMenuChanged" Unchecked="OnTestMenuChanged" />
            <CheckBox x:Name="SeamlessBox" Content="Seamless Co-op" Foreground="#E6E0D4" Margin="16,0,0,0"
                      VerticalAlignment="Center" Checked="OnSeamlessChanged" Unchecked="OnSeamlessChanged"
                      ToolTip="Loads Seamless Co-op from your own download (pick its ersc.dll). Everyone in the session needs the same mod code shown above." />
            <Button x:Name="RebuildButton" Content="Rebuild content" Margin="16,0,0,0" Click="OnRebuildContent" />
            <Button Content="Fallbacks…" Click="OnFallbacks"
                    ToolTip="If a feature doesn't work in game, switch it to another method (B, C, …) here. Changing a build method rebuilds the content on the next PLAY." />
            <Button Content="Pre-flight check…" Click="OnPreflight"
                    ToolTip="Checks the game paths, me3 profile, sound banks and event flags before you test, and saves a zip of every log and report after a test." />
            <Button Content="Open mod folder" Click="OnOpenModFolder" />
            <Button x:Name="UninstallButton" Content="Uninstall…" Click="OnUninstall"
                    ToolTip="Removes the mod and everything the launcher downloaded or built. Your games are not changed; you choose whether to keep your saves." />
          </StackPanel>
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- Everything the launcher does, porter output included, also written to TheDarkSignLauncher.log next to the exe. -->
    <Expander x:Name="LogExpander" DockPanel.Dock="Bottom" Margin="0,6,0,0" Foreground="#E6E0D4"
              Header="Launcher activity (everything the launcher is doing)">
      <DockPanel Margin="0,4,0,0">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,4">
          <CheckBox x:Name="LogFollowBox" Content="Follow new lines" IsChecked="True" Foreground="#E6E0D4" VerticalAlignment="Center" />
          <Button Content="Copy" Margin="12,0,0,0" Click="OnCopyLog" />
          <Button Content="Open log file" Click="OnOpenLogFile" />
          <Button Content="Clear" Click="OnClearLog" />
        </StackPanel>
        <TextBox x:Name="LogBox" Height="190" IsReadOnly="True" FontFamily="Consolas" FontSize="12"
                 Background="#0F0E12" Foreground="#CFC8BA" BorderBrush="#3A3542" TextWrapping="NoWrap"
                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" />
      </DockPanel>
    </Expander>
    <TextBlock x:Name="StatusText" DockPanel.Dock="Bottom" Margin="0,8,0,0" Opacity="0.8" TextWrapping="Wrap" />
    <TextBlock x:Name="GamesHint" DockPanel.Dock="Top" Opacity="0.75" Margin="0,0,0,4" TextWrapping="Wrap"
               Text="Your games: point each one at your own install with Browse… (a Steam copy is fine; it is only read). Both are needed to build the mod." />

    <Grid>
    <DataGrid x:Name="GameGrid" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
              HeadersVisibility="Column" RowHeight="34" GridLinesVisibility="Horizontal"
              Background="#1F1C24" RowBackground="#1F1C24" Foreground="#E6E0D4" BorderBrush="#3A3542">
      <DataGrid.ColumnHeaderStyle>
        <Style TargetType="DataGridColumnHeader">
          <Setter Property="Background" Value="#2A2630" />
          <Setter Property="Foreground" Value="#E6E0D4" />
          <Setter Property="Padding" Value="6,4" />
        </Style>
      </DataGrid.ColumnHeaderStyle>
      <DataGrid.Columns>
        <DataGridTextColumn Header="Game" Binding="{Binding DisplayName}" IsReadOnly="True" Width="130" />
        <DataGridTextColumn Header="Exe" Binding="{Binding ExePath}" IsReadOnly="True" Width="*" />
        <DataGridTextColumn Header="Launch arguments" Binding="{Binding Arguments, UpdateSourceTrigger=PropertyChanged}" Width="140" />
        <DataGridTextColumn Header="Status" Binding="{Binding Status}" IsReadOnly="True" Width="140" />
        <DataGridTemplateColumn Width="150">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <StackPanel Orientation="Horizontal">
                <Button Content="Browse…" Click="OnBrowseExe" />
                <Button Content="Launch" Click="OnLaunch" FontWeight="SemiBold" IsEnabled="{Binding CanLaunch}" />
              </StackPanel>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
      </DataGrid.Columns>
    </DataGrid>

    <!-- Shown while the content builds: the Darksign ignites as the build goes, with a bar across the panel. -->
    <Border x:Name="BuildPanel" Visibility="Collapsed" Background="#0B0A0D" BorderBrush="#6B5A3A" BorderThickness="1" Padding="16">
      <DockPanel>
        <Grid DockPanel.Dock="Bottom" Margin="0,12,0,0" Height="14">
          <Border x:Name="BarTrack" Background="#1C1820" CornerRadius="7" BorderBrush="#3A2E22" BorderThickness="1" />
          <Border x:Name="BarFill" HorizontalAlignment="Left" Width="0" CornerRadius="7">
            <Border.Background>
              <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                <GradientStop Color="#5A1A04" Offset="0" />
                <GradientStop Color="#C2410C" Offset="0.6" />
                <GradientStop Color="#FDBA54" Offset="1" />
              </LinearGradientBrush>
            </Border.Background>
            <Border.Effect>
              <DropShadowEffect Color="#FF7A1A" BlurRadius="14" ShadowDepth="0" Opacity="0.9" />
            </Border.Effect>
          </Border>
        </Grid>
        <local:DarksignProgress x:Name="Darksign" DockPanel.Dock="Left" Width="230" Height="230" Margin="0,0,20,0" />
        <StackPanel VerticalAlignment="Center">
          <TextBlock x:Name="BuildTitle" Text="Kindling the Dark Sign…" FontSize="22" Foreground="#F2C27A"
                     FontWeight="SemiBold" />
          <TextBlock Text="Building the mod from your own game files." Opacity="0.75" Margin="0,2,0,14" />
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="130" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
            </Grid.RowDefinitions>
            <TextBlock Text="Time elapsed" Opacity="0.7" />
            <TextBlock x:Name="ElapsedText" Grid.Column="1" Text="0:00" FontSize="16" FontWeight="SemiBold" />
            <TextBlock Grid.Row="1" Text="Time remaining" Opacity="0.7" Margin="0,4,0,0" />
            <TextBlock x:Name="RemainingText" Grid.Row="1" Grid.Column="1" Text="estimating…" FontSize="16" FontWeight="SemiBold" Margin="0,4,0,0" />
            <TextBlock Grid.Row="2" Text="Weapons" Opacity="0.7" Margin="0,12,0,0" />
            <TextBlock x:Name="WeaponsLine" Grid.Row="2" Grid.Column="1" Opacity="0.85" Margin="0,12,0,0" TextTrimming="CharacterEllipsis" />
            <TextBlock Grid.Row="3" Text="Maps" Opacity="0.7" Margin="0,4,0,0" />
            <TextBlock x:Name="MapsLine" Grid.Row="3" Grid.Column="1" Opacity="0.85" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
          </Grid>
          <TextBlock Text="Every line the build prints is in Launcher activity below." Opacity="0.55" Margin="0,14,0,0" />
        </StackPanel>
      </DockPanel>
    </Border>
    </Grid>
  </DockPanel>
</Window>
