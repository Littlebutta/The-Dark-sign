<!--
  The launcher's Dark Souls menu look (after DS3's options screens): smoky dark backdrop, Garamond-style serif text,
  thin rules that fade out at both ends, flat dark controls, and the orange ember glow under whatever the mouse is on.
  Fonts: EB Garamond and Cinzel (both SIL OFL 1.1, Assets/*-OFL.txt). Merged in App.xaml, so every window gets it.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Colours -->
  <Color x:Key="TextColor">#DCD6C9</Color>
  <Color x:Key="DimTextColor">#9A9385</Color>
  <Color x:Key="EmberColor">#F08A2C</Color>
  <Color x:Key="RuleColor">#8A8070</Color>
  <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}" />
  <SolidColorBrush x:Key="DimTextBrush" Color="{StaticResource DimTextColor}" />
  <SolidColorBrush x:Key="TitleBrush" Color="#EDE6D6" />
  <SolidColorBrush x:Key="AccentBrush" Color="#E9B872" />
  <SolidColorBrush x:Key="PanelBrush" Color="#B0141210" />
  <SolidColorBrush x:Key="FieldBrush" Color="#C80C0B0A" />
  <SolidColorBrush x:Key="FrameBrush" Color="#5A5246" />
  <SolidColorBrush x:Key="FrameLightBrush" Color="#8A8070" />

  <FontFamily x:Key="MenuFont">pack://application:,,,/Assets/#EB Garamond, Georgia</FontFamily>
  <FontFamily x:Key="TitleFont">pack://application:,,,/Assets/#Cinzel, pack://application:,,,/Assets/#Cinzel SemiBold, Georgia</FontFamily>

  <ImageBrush x:Key="BackdropBrush" ImageSource="pack://application:,,,/Assets/menu-background.jpg" Stretch="UniformToFill" />

  <!-- A rule that fades in and out at the ends, like the lines under DS3's menu headers and rows. -->
  <LinearGradientBrush x:Key="RuleBrush" StartPoint="0,0" EndPoint="1,0">
    <GradientStop Color="#008A8070" Offset="0" />
    <GradientStop Color="#C08A8070" Offset="0.18" />
    <GradientStop Color="#C08A8070" Offset="0.82" />
    <GradientStop Color="#008A8070" Offset="1" />
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="FaintRuleBrush" StartPoint="0,0" EndPoint="1,0">
    <GradientStop Color="#006A6255" Offset="0" />
    <GradientStop Color="#706A6255" Offset="0.15" />
    <GradientStop Color="#706A6255" Offset="0.85" />
    <GradientStop Color="#006A6255" Offset="1" />
  </LinearGradientBrush>

  <!-- The ember glow DS3 puts under the selected row. -->
  <RadialGradientBrush x:Key="EmberGlowBrush" Center="0.5,1" GradientOrigin="0.5,1" RadiusX="0.6" RadiusY="1.1">
    <GradientStop Color="#C8F08A2C" Offset="0" />
    <GradientStop Color="#50B4501A" Offset="0.45" />
    <GradientStop Color="#00B4501A" Offset="1" />
  </RadialGradientBrush>
  <LinearGradientBrush x:Key="EmberLineBrush" StartPoint="0,0" EndPoint="1,0">
    <GradientStop Color="#00F08A2C" Offset="0" />
    <GradientStop Color="#FFF3A24A" Offset="0.5" />
    <GradientStop Color="#00F08A2C" Offset="1" />
  </LinearGradientBrush>

  <!-- Window: the smoky backdrop. Apply with Style="{StaticResource MenuWindow}" (or Theme.Apply for code windows). -->
  <Style x:Key="MenuWindow" TargetType="Window">
    <Setter Property="Background" Value="{StaticResource BackdropBrush}" />
    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
    <Setter Property="FontFamily" Value="{StaticResource MenuFont}" />
    <Setter Property="FontSize" Value="15" />
    <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
    <Setter Property="TextOptions.TextRenderingMode" Value="ClearType" />
  </Style>
  <Style TargetType="Window" BasedOn="{StaticResource MenuWindow}" />

  <Style TargetType="TextBlock">
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- Section header like DS3's "Menu controls": small dim title over a fading rule. Use on a HeaderedContentControl-free
       TextBlock with Style="{StaticResource SectionTitle}" and put a Rule under it. -->
  <Style x:Key="SectionTitle" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{StaticResource DimTextBrush}" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Margin" Value="2,0,0,2" />
  </Style>
  <Style x:Key="Rule" TargetType="Border">
    <Setter Property="Height" Value="1" />
    <Setter Property="Background" Value="{StaticResource RuleBrush}" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
  </Style>

  <!-- Buttons: flat dark plates with a hairline frame; hover lights the ember glow and line underneath. -->
  <Style TargetType="Button">
    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
    <Setter Property="FontFamily" Value="{StaticResource MenuFont}" />
    <Setter Property="FontSize" Value="15" />
    <Setter Property="Padding" Value="14,3" />
    <Setter Property="Margin" Value="4,0,0,0" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Grid x:Name="Root" Background="Transparent">
            <Border x:Name="Plate" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource FrameBrush}" BorderThickness="1" />
            <Border x:Name="Glow" Background="{StaticResource EmberGlowBrush}" Opacity="0" Margin="1" />
            <Border x:Name="Line" Height="1" VerticalAlignment="Bottom" Background="{StaticResource EmberLineBrush}" Opacity="0" Margin="1,0,1,1" />
            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Glow" Property="Opacity" Value="0.85" />
              <Setter TargetName="Line" Property="Opacity" Value="1" />
              <Setter TargetName="Plate" Property="BorderBrush" Value="{StaticResource FrameLightBrush}" />
              <Setter Property="Foreground" Value="{StaticResource TitleBrush}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Line" Property="Opacity" Value="1" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Glow" Property="Opacity" Value="1" />
              <Setter TargetName="Plate" Property="Background" Value="#D01A1612" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Root" Property="Opacity" Value="0.4" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- The big PLAY button: Cinzel, a bronze frame, and a steady faint glow. -->
  <Style x:Key="PlayButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
    <Setter Property="FontFamily" Value="{StaticResource TitleFont}" />
    <Setter Property="FontSize" Value="24" />
    <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Grid x:Name="Root" Background="Transparent">
            <Border Background="#D0100E0C" BorderBrush="#8C7448" BorderThickness="1" />
            <Border BorderBrush="#40D8B070" BorderThickness="1" Margin="3" />
            <Border x:Name="Glow" Background="{StaticResource EmberGlowBrush}" Opacity="0.35" Margin="4" />
            <Border x:Name="Line" Height="1" VerticalAlignment="Bottom" Background="{StaticResource EmberLineBrush}" Opacity="0.5" Margin="4,0,4,4" />
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Glow" Property="Opacity" Value="1" />
              <Setter TargetName="Line" Property="Opacity" Value="1" />
              <Setter Property="Foreground" Value="#FFE7C08A" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Root" Property="Opacity" Value="0.55" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Text fields: dark wells with a hairline frame that warms on focus. -->
  <Style TargetType="TextBox">
    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
    <Setter Property="Background" Value="{StaticResource FieldBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource FrameBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CaretBrush" Value="{StaticResource AccentBrush}" />
    <Setter Property="SelectionBrush" Value="#B4501A" />
    <Setter Property="Padding" Value="4,2" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TextBox">
          <Border x:Name="Frame" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}" SnapsToDevicePixels="True">
            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" Focusable="False"
                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Frame" Property="BorderBrush" Value="#B08A5A" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Frame" Property="Opacity" Value="0.5" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Check boxes: a small bronze-framed square with an ember mark. -->
  <Style TargetType="CheckBox">
    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
    <Setter Property="FontFamily" Value="{StaticResource MenuFont}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="CheckBox">
          <StackPanel Orientation="Horizontal" Background="Transparent">
            <Grid Width="16" Height="16" VerticalAlignment="Center">
              <Border x:Name="Box" Background="{StaticResource FieldBrush}" BorderBrush="{StaticResource FrameLightBrush}" BorderThickness="1" />
              <Border x:Name="Mark" Margin="4" Background="#F3A24A" Opacity="0">
                <Border.Effect>
                  <DropShadowEffect Color="#F08A2C" BlurRadius="8" ShadowDepth="0" Opacity="0.9" />
                </Border.Effect>
              </Border>
            </Grid>
            <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True" />
          </StackPanel>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Mark" Property="Opacity" Value="1" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Box" Property="BorderBrush" Value="#D8B070" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.45" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Drop-downs -->
  <Style x:Key="ComboToggle" TargetType="ToggleButton">
    <Setter Property="Focusable" Value="False" />
    <Setter Property="ClickMode" Value="Press" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToggleButton">
          <Border x:Name="Frame" Background="{StaticResource FieldBrush}" BorderBrush="{StaticResource FrameBrush}" BorderThickness="1">
            <Path x:Name="Arrow" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0"
                  Data="M 0 0 L 4 4 L 8 0 Z" Fill="{StaticResource DimTextBrush}" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Frame" Property="BorderBrush" Value="{StaticResource FrameLightBrush}" />
              <Setter TargetName="Arrow" Property="Fill" Value="{StaticResource AccentBrush}" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Frame" Property="BorderBrush" Value="#B08A5A" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="ComboBox">
    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
    <Setter Property="FontFamily" Value="{StaticResource MenuFont}" />
    <Setter Property="FontSize" Value="15" />
    <Setter Property="MinHeight" Value="26" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
    <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ComboBox">
          <Grid>
            <ToggleButton Style="{StaticResource ComboToggle}"
                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" />
            <ContentPresenter Margin="8,2,26,2" VerticalAlignment="Center" HorizontalAlignment="Left" IsHitTestVisible="False"
                              Content="{TemplateBinding SelectionBoxItem}"
                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" />
            <Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade"
                   IsOpen="{TemplateBinding IsDropDownOpen}">
              <Border MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="{TemplateBinding MaxDropDownHeight}"
                      Background="#F2141210" BorderBrush="{StaticResource FrameLightBrush}" BorderThickness="1">
                <ScrollViewer SnapsToDevicePixels="True">
                  <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained" />
                </ScrollViewer>
              </Border>
            </Popup>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.5" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="ComboBoxItem">
    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
    <Setter Property="Padding" Value="10,4" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ComboBoxItem">
          <Grid Background="Transparent">
            <Border x:Name="Glow" Background="{StaticResource EmberGlowBrush}" Opacity="0" />
            <Border x:Name="Line" Height="1" VerticalAlignment="Bottom" Background="{StaticResource EmberLineBrush}" Opacity="0" />
            <ContentPresenter Margin="{TemplateBinding Padding}" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsHighlighted" Value="True">
              <Setter TargetName="Glow" Property="Opacity" Value="0.8" />
              <Setter TargetName="Line" Property="Opacity" Value="1" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Expander (the Launcher activity drop-down): header with a small arrow over a fading rule. -->
  <Style TargetType="Expander">
    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Expander">
          <DockPanel>
            <ToggleButton DockPanel.Dock="Top" Cursor="Hand" Focusable="False" Content="{TemplateBinding Header}"
                          IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
              <ToggleButton.Template>
                <ControlTemplate TargetType="ToggleButton">
                  <Grid Background="Transparent">
                    <StackPanel Orientation="Horizontal" Margin="0,2,0,4">
                      <Path x:Name="Arrow" Data="M 0 0 L 4 4 L 0 8 Z" Fill="{StaticResource DimTextBrush}" VerticalAlignment="Center" Margin="2,0,8,0" />
                      <ContentPresenter VerticalAlignment="Center" TextElement.Foreground="{StaticResource DimTextBrush}" />
                    </StackPanel>
                    <Border Height="1" VerticalAlignment="Bottom" Background="{StaticResource FaintRuleBrush}" />
                  </Grid>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsChecked" Value="True">
                      <Setter TargetName="Arrow" Property="Data" Value="M 0 0 L 8 0 L 4 4 Z" />
                    </Trigger>
                    <Trigger Property="IsMouseOver" Value="True">
                      <Setter TargetName="Arrow" Property="Fill" Value="{StaticResource AccentBrush}" />
                    </Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </ToggleButton.Template>
            </ToggleButton>
            <ContentPresenter x:Name="Body" Visibility="Collapsed" />
          </DockPanel>
          <ControlTemplate.Triggers>
            <Trigger Property="IsExpanded" Value="True">
              <Setter TargetName="Body" Property="Visibility" Value="Visible" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Scroll bars: thin, dark, bronze thumb. -->
  <Style x:Key="ScrollThumb" TargetType="Thumb">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Thumb">
          <Border x:Name="T" Background="#6A6050" CornerRadius="3" Margin="2" />
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="T" Property="Background" Value="#A8906A" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="ScrollPage" TargetType="RepeatButton">
    <Setter Property="Focusable" Value="False" />
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RepeatButton">
          <Border Background="Transparent" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="ScrollBar">
    <Setter Property="Background" Value="#600C0B0A" />
    <Style.Triggers>
      <Trigger Property="Orientation" Value="Vertical">
        <Setter Property="Width" Value="10" />
        <Setter Property="MinWidth" Value="10" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="ScrollBar">
              <Border Background="{TemplateBinding Background}">
                <Track x:Name="PART_Track" IsDirectionReversed="True">
                  <Track.DecreaseRepeatButton>
                    <RepeatButton Style="{StaticResource ScrollPage}" Command="ScrollBar.PageUpCommand" />
                  </Track.DecreaseRepeatButton>
                  <Track.Thumb>
                    <Thumb Style="{StaticResource ScrollThumb}" />
                  </Track.Thumb>
                  <Track.IncreaseRepeatButton>
                    <RepeatButton Style="{StaticResource ScrollPage}" Command="ScrollBar.PageDownCommand" />
                  </Track.IncreaseRepeatButton>
                </Track>
              </Border>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Trigger>
      <Trigger Property="Orientation" Value="Horizontal">
        <Setter Property="Height" Value="10" />
        <Setter Property="MinHeight" Value="10" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="ScrollBar">
              <Border Background="{TemplateBinding Background}">
                <Track x:Name="PART_Track">
                  <Track.DecreaseRepeatButton>
                    <RepeatButton Style="{StaticResource ScrollPage}" Command="ScrollBar.PageLeftCommand" />
                  </Track.DecreaseRepeatButton>
                  <Track.Thumb>
                    <Thumb Style="{StaticResource ScrollThumb}" />
                  </Track.Thumb>
                  <Track.IncreaseRepeatButton>
                    <RepeatButton Style="{StaticResource ScrollPage}" Command="ScrollBar.PageRightCommand" />
                  </Track.IncreaseRepeatButton>
                </Track>
              </Border>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Trigger>
    </Style.Triggers>
  </Style>

  <!-- Tool tips -->
  <Style TargetType="ToolTip">
    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
    <Setter Property="Background" Value="#F2141210" />
    <Setter Property="BorderBrush" Value="{StaticResource FrameLightBrush}" />
    <Setter Property="FontFamily" Value="{StaticResource MenuFont}" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="MaxWidth" Value="420" />
    <Setter Property="Padding" Value="8,5" />
    <Setter Property="ContentTemplate">
      <Setter.Value>
        <DataTemplate>
          <TextBlock Text="{Binding}" TextWrapping="Wrap" />
        </DataTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- The game list, laid out like DS3's key binding table: centred dim headers, rows on fading rules, ember on the
       selected row. -->
  <Style TargetType="DataGrid">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="RowBackground" Value="Transparent" />
    <Setter Property="AlternatingRowBackground" Value="Transparent" />
    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="GridLinesVisibility" Value="None" />
    <Setter Property="HeadersVisibility" Value="Column" />
    <Setter Property="RowHeight" Value="36" />
    <Setter Property="SelectionMode" Value="Single" />
  </Style>
  <Style TargetType="DataGridColumnHeader">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{StaticResource DimTextBrush}" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="Padding" Value="6,4" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="DataGridColumnHeader">
          <Grid>
            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
            <Border Height="1" VerticalAlignment="Bottom" Background="{StaticResource RuleBrush}" />
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="DataGridRow">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="DataGridRow">
          <Grid>
            <Border x:Name="Glow" Background="{StaticResource EmberGlowBrush}" Opacity="0" />
            <Border x:Name="Line" Height="1" VerticalAlignment="Bottom" Background="{StaticResource EmberLineBrush}" Opacity="0" />
            <Border Height="1" VerticalAlignment="Bottom" Background="{StaticResource FaintRuleBrush}" />
            <DataGridCellsPresenter ItemsPanel="{TemplateBinding ItemsPanel}" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Glow" Property="Opacity" Value="0.45" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="Glow" Property="Opacity" Value="0.8" />
              <Setter TargetName="Line" Property="Opacity" Value="1" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="DataGridCell">
    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="DataGridCell">
          <Border Background="Transparent" Padding="6,0">
            <ContentPresenter VerticalAlignment="Center" />
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>
